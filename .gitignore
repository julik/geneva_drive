# Bundler
/.bundle/
/vendor/bundle
Gemfile.lock

# LLM
/.claude/

# Generated documentation
/doc/
/.yardoc/

# Test dummy app
# Every database task writes into db/<adapter>/ - schema dump, SQLite files and
# the one-per-parallel-worker copies of them. See test/dummy/config/database.yml.
/test/dummy/db/*/
!/test/dummy/db/migrate/
/test/dummy/db/migrate/*geneva_drive*.rb
# Written by the install generator when the test suite prepares the dummy app
/test/dummy/config/initializers/geneva_drive.rb
/test/dummy/log/*.log*
/test/dummy/storage/
/test/dummy/tmp/

# IDE
/.idea/
*.swp
*.swo
*~
.tm-properties

# macOS
.DS_Store

# Additional reference
additional_reference/

# Playwright used by LLMs
.playwright-mcp/

# Built gems
/pkg/

# Scratch directory - keep the directory, ignore everything in it
/tmp/*
!/tmp/.keep
