# Bundler
/.bundle/
/vendor/bundle
Gemfile.lock

# LLM
/.claude/

# Generated documentation
/doc/
/.yardoc/

# Test dummy app
/test/dummy/db/*.sqlite3
# Parallel test workers get one database each, suffixed -0/_0 depending on the Rails version
/test/dummy/db/*.sqlite3-*
/test/dummy/db/*.sqlite3_*
/test/dummy/db/migrate/*geneva_drive*.rb
/test/dummy/db/schema.rb
/test/dummy/db/.schema_adapter
# Written by the install generator when the test suite prepares the dummy app
/test/dummy/config/initializers/geneva_drive.rb
/test/dummy/log/*.log*
/test/dummy/storage/
/test/dummy/tmp/

# IDE
/.idea/
*.swp
*.swo
*~
.tm-properties

# macOS
.DS_Store

# Additional reference
additional_reference/

# Playwright used by LLMs
.playwright-mcp/

# Built gems
/pkg/

# Scratch directory - keep the directory, ignore everything in it
/tmp/*
!/tmp/.keep
